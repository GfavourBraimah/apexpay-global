# ApexPay Global — Frontend Environment Variables
# Copy this file to `.env` for local overrides. Vite only exposes
# variables prefixed with VITE_ to client-side code.

# Base URL of the auth-service API (defaults to http://localhost:8001)
VITE_AUTH_API_URL=http://localhost:8001

# Base URL of the ledger-service API (defaults to http://localhost:8002)
VITE_LEDGER_API_URL=http://localhost:8002
