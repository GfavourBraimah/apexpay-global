# ApexPay Global — Local Development Environment Variables
# Copy this file to `.env` and adjust values as needed.
# NEVER commit a real `.env` file with production credentials.

# --- PostgreSQL ---
DB_USER=apex_admin
DB_PASSWORD=apex_secure_pass
DB_NAME=apexpay_db

# --- Shared database connection string ---
# Consumed exclusively by auth-service and ledger-service. Both services
# fail fast at startup if this is not set — there is no hardcoded fallback.
DATABASE_URL=postgresql://apex_admin:apex_secure_pass@postgres:5432/apexpay_db

# --- JWT (shared by auth-service and ledger-service) ---
# auth-service signs tokens with these settings; ledger-service verifies
# tokens using the same JWT_SECRET/JWT_ALGORITHM. No default/fallback
# values exist in code — all three must be set or the services refuse
# to start.
JWT_SECRET=supersecretkey123
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1
